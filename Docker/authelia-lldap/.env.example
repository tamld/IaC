# Base Domain & Base DN
DOMAIN=example.com
LDAP_BASE_DN=dc=example,dc=com

# LLDAP Secrets
LLDAP_JWT_SECRET=ReplaceWithRandom32CharsLongSecretString123!
LLDAP_KEY_SEED=ReplaceWithRandom32CharsLongSecretString123!
LLDAP_ADMIN_PASSWORD=AdminSecurePassword123!

# Authelia Secrets
AUTHELIA_JWT_SECRET=ReplaceWithRandom32CharsLongSecretString123!
AUTHELIA_SESSION_SECRET=ReplaceWithRandom32CharsLongSecretString123!
AUTHELIA_STORAGE_KEY=ReplaceWithRandom32CharsLongSecretString123!

# Ports
LLDAP_WEB_PORT=17170
LLDAP_LDAP_PORT=3890
AUTHELIA_PORT=9091
